    "def not_started(ids):\n",
    "    dd = []\n",
    "    for id in ids:\n",
    "        if id is not None:\n",
    "            base_data = {}\n",
    "            url = f\"https://www.fotmob.com/api/matchDetails?matchId={id}\"\n",
    "            print(url)\n",
    "            response = session.get(url)\n",
    "            data = json.loads(response.content)    \n",
    "            base_data[\"match_date\"] = data[\"general\"][\"matchTimeUTCDate\"].split(\"T\")[0]\n",
    "            base_data[\"league_name\"] = data[\"general\"][\"leagueName\"]\n",
    "            base_data[\"matchid\"] = data[\"general\"][\"matchId\"]\n",
    "            base_data[\"home_team\"] = data[\"general\"][\"homeTeam\"][\"name\"]\n",
    "            base_data[\"away_team\"] = data[\"general\"][\"awayTeam\"][\"name\"]\n",
    "            if \"voteResult\" in data[\"content\"][\"matchFacts\"][\"poll\"]:\n",
    "                votes = [\n",
    "                    item[\"Votes\"]\n",
    "                    for item in data[\"content\"][\"matchFacts\"][\"poll\"][\n",
    "                        \"voteResult\"\n",
    "                    ][\"Votes\"]\n",
    "                    if len(item[\"Votes\"]) == 3\n",
    "                ]\n",
    "            else:\n",
    "                votes = None\n",
    "            if not votes:\n",
    "                base_data[\"home_probability_win\"] = None\n",
    "                base_data[\"draw_probability\"] = None\n",
    "                base_data[\"away_probability_win\"] = None\n",
    "            else:\n",
    "                base_data[\"home_probability_win\"] = (\n",
    "                    votes[0][0] / sum(votes[0])\n",
    "                    if isinstance(votes[0], list)\n",
    "                    else None\n",
    "                )\n",
    "                base_data[\"draw_probability\"] = (\n",
    "                    votes[0][1] / sum(votes[0])\n",
    "                    if isinstance(votes[0], list)\n",
    "                    else None\n",
    "                )\n",
    "                base_data[\"away_probability_win\"] = (\n",
    "                    votes[0][2] / sum(votes[0])\n",
    "                    if isinstance(votes[0], list)\n",
    "                    else None\n",
    "                )\n",
    "                bb = pd.DataFrame(base_data, index=[0])\n",
    "        else:\n",
    "            bb = pd.DataFrame()\n",
    "        print(base_data)\n",
    "        dd.append(bb)\n",
    "    if len(dd) > 0:\n",
    "        df = pd.concat(dd, axis=0)\n",
    "    else:\n",
    "        df = pd.DataFrame()\n",
    "    return df\n"
   ]
