    "def all_matches_data(url):\n",
    "    response = session.get(url)\n",
    "    data = json.loads(response.content)\n",
    "    ids = [\n",
    "        box[\"id\"]\n",
    "        for box in data[\"matches\"][\"allMatches\"]\n",
    "        if box[\"status\"][\"started\"] == True\n",
    "    ]\n",
    "\n",
    "\n",
    "    not_started_ids = []\n",
    "    counter = 0\n",
    "    for box in data[\"matches\"][\"allMatches\"]:\n",
    "        if not box[\"status\"][\"started\"]:\n",
    "            not_started_ids.append(box[\"id\"])\n",
    "            counter += 1\n",
    "            if counter == 10:\n",
    "                break\n",
    "    print(len(not_started_ids))\n",
    "    return ids, not_started_ids\n"
   ]
